# --- FinQuest env ---
# Copy to .env.local and fill in. The app works WITHOUT these —
# scores save to the phone/browser (localStorage) and the verdict
# falls back to the built-in rule-based AI. Add keys to go live.
# NEVER commit .env.local. No key is hard-coded anywhere in the app.

# ============ 1. DATABASE — direct Postgres URL (primary) ============
# Supabase Postgres: Dashboard -> Settings -> Database -> Connection string
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Supabase pooler (if direct 5432 is blocked): port 6543 + ?pgbouncer=true
# Any plain Postgres 14+ works the same way.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Alternative (only if you do NOT use DATABASE_URL):
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ============ 2. TOKENHARBOR AI — all 3 vars ============
# Base URL, model and API key. The verdict route reads exactly these.
TOKENHARBOR_BASE_URL=https://your-tokenharbor-base-url-here
TOKENHARBOR_MODEL=mimo-v2.6-flash:free
TOKENHARBOR_API_KEY=your-tokenharbor-api-key
